{
    "name": "max-messenger-bot/max-bot-uploader-php",
    "description": "PHP library for uploading files via the Max Messenger Bot API",
    "keywords": [
        "max",
        "messenger",
        "bot",
        "max messenger",
        "max bot",
        "upload",
        "uploader",
        "php"
    ],
    "type": "library",
    "license": "MIT",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MaxMessenger\\Uploader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaxMessenger\\Uploader\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eugene Makhaev",
            "email": "mj4444@mail.ru"
        }
    ],
    "support": {
        "email": "mj4444@mail.ru",
        "chat": "https://t.me/mj4444ru"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "max-messenger-bot/max-bot-api-php": "^1.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "sebastian/diff": "^6.0",
        "symfony/console": "^7.4",
        "vimeo/psalm": "^7.10"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "psalm": "psalm",
        "test": "codecept run"
    },
    "config": {
        "sort-packages": true
    }
}
